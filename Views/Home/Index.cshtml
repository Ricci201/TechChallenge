@{
    ViewData["Title"] = "TechChallenge";
    var teste = "Olá, bem vindo";
}


<div class="container mt-5">


    <!-- Hero -->
    <div class="container text-center mt-5">
        <h1 class="display-4 fw-bold">@teste</h1>

        <h1 class="display-4 fw-bold">
            TechChallenge
        </h1>

        <h2 class="fw-semibold text-primary">
            Plataforma de Projetos e Inovação Estudantil
        </h2>

        <p class="lead mt-3 text-muted">
            O lugar onde suas ideias viram projetos reais
        </p>

    </div>



    <!-- Cards -->
    <div class="row justify-content-center g-4">


        <div class="col-md-4">

            <div class="card h-100 shadow border-0">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        👥
                    </div>

                    <h4 class="card-title">
                        Crie equipes e projetos
                    </h4>

                    <p class="card-text text-muted">
                        Monte equipes, organize ideias e desenvolva projetos inovadores junto com outros estudantes.
                    </p>

                </div>

            </div>

        </div>




        <div class="col-md-4">

            <div class="card h-100 shadow border-0">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        🏆
                    </div>

                    <h4 class="card-title">
                        Participe de desafios
                    </h4>

                    <p class="card-text text-muted">
                        Enfrente desafios tecnológicos, desenvolva soluções e coloque seus conhecimentos em prática.
                    </p>

                </div>

            </div>

        </div>




        <div class="col-md-4">

            <div class="card h-100 shadow border-0">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        ⭐
                    </div>

                    <h4 class="card-title">
                        Ganhe pontos e suba no ranking
                    </h4>

                    <p class="card-text text-muted">
                        Acumule pontos através dos projetos realizados e destaque seu desempenho.
                    </p>

                </div>

            </div>

        </div>


    </div>


</div>