@model TechChallenge.PerfilAdminExcluirViewModel

@{
    ViewData["Title"] = "Remover perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1>Remover perfil</h1>

        <form asp-action="ExcluirRole" method="post">
            <input asp-for="Id" type="hidden" />
            <p>Deseja remover o perfil <strong>@Model.Nome</strong>?</p>

            @if (Model.TotalUsuarios > 0)
            {
                <div class="alert alert-warning">
                    Este perfil possui @Model.TotalUsuarios usuário(s) vinculado(s) e não pode ser removido.
                </div>
            }
            else if (string.Equals(Model.Nome, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-warning">
                    O perfil Admin é necessário para acessar este painel e não pode ser removido.
                </div>
            }

            <div class="d-flex gap-2">
                @if (Model.TotalUsuarios == 0 && !string.Equals(Model.Nome, "Admin", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="submit" class="btn btn-danger">Remover perfil</button>
                }
                <a asp-action="Roles" class="btn btn-outline-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>
