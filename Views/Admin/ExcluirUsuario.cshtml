@model TechChallenge.UsuarioAdminExcluirViewModel

@{
    ViewData["Title"] = "Remover usuário";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1>Remover usuário</h1>
        <p class="text-muted">Esta ação não pode ser desfeita.</p>

        <form asp-action="ExcluirUsuario" method="post">
            <input asp-for="Id" type="hidden" />
            <dl class="row mb-4">
                <dt class="col-sm-4">E-mail</dt>
                <dd class="col-sm-8">@Model.Email</dd>
                <dt class="col-sm-4">Perfil</dt>
                <dd class="col-sm-8">@Model.Perfil</dd>
            </dl>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Remover usuário</button>
                <a asp-action="Usuarios" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
