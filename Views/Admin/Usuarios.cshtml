@model IEnumerable<TechChallenge.UsuarioAdminListaViewModel>

@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Usuários</h1>
        <p class="text-muted mb-0">Crie contas, altere dados e defina o perfil de acesso.</p>
    </div>
    <a asp-action="CriarUsuario" class="btn btn-primary">Novo usuário</a>
</div>

<div class="tech-table-wrap">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>E-mail</th>
                    <th>Perfil</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Email</td>
                            <td><span class="badge bg-secondary">@usuario.Perfil</span></td>
                            <td>
                                <div class="table-actions justify-content-end">
                                    <a asp-action="EditarUsuario" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="ExcluirUsuario" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-danger">Remover</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">Nenhum usuário cadastrado.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
