<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechChallenge</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechChallenge.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm tech-navbar navbar-dark mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Tech" asp-action="Index">TechChallenge</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Tech" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Tech" asp-action="About">Sobre</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Tech" asp-action="Contact">Contato</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Tech" asp-action="Dashboard">Desafios</a>
                        </li> 

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Alunos" asp-action="Index">Alunos</a>
                        </li> 

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Categorias" asp-action="Index">Categorias</a>
                        </li> 

                         <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Professores" asp-action="Index">Professor</a>
                        </li> 

                          <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Equipes" asp-action="Index">Equipe</a>
                        </li> 

                         <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Projetos" asp-action="Index">Projeto</a>
                        </li> 
                        
                    </ul>
                    <partial name="_LoginPartial"/>

                </div>
            </div>
        </nav>
    </header>
    <div class="container tech-page">
        <main role="main" class="pb-3">
            <div class="container mt-2">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>            
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center">
        <div class="container">
            &copy; 2026 - TechChallenge feito por Rayane - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
