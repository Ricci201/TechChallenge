@{
    ViewData["Title"] = "Desafios Disponíveis";
}

<div class="container py-4 tech-page">
    <section class="tech-hero text-center mb-4">
        <p class="tech-chip mb-3">Ranking e desafios</p>
        <h1 class="display-5 fw-bold mb-3">🏆 Desafios Disponíveis</h1>
        <p class="lead text-muted mb-0">Explore atividades, ganhe pontos e acompanhe sua evolução na plataforma.</p>
    </section>

    <div class="row g-4">
        @foreach (var desafio in ViewBag.Desafios)
        {
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card tech-card tech-dashboard-card h-100 border-0">
                    <div class="card-body d-flex flex-column">
                        <span class="tech-chip mb-3 align-self-start">@desafio.Categoria</span>
                        <h2 class="h5 fw-bold">@desafio.Nome</h2>
                        <p class="card-text text-muted flex-grow-1">@desafio.Descricao</p>
                        <div class="tech-stat mt-3">
                            <strong>🏅 @desafio.Pontuacao pts</strong>
                            <span>Desafio em destaque</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>